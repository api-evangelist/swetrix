        {
          "id": "3811dfe6-0a5e-49df-abfb-b9b66a510657",
          "name": "Record Error Event",
          "request": {
            "name": "Record Error Event",
            "description": {
              "content": "Records a JavaScript error event for aggregation in the Errors tab of the dashboard. Captures error name, message, stack trace, source file, and location. Errors are grouped by name and message.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "log",
                "error"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pid\": \"<string>\",\n  \"name\": \"<string>\",\n  \"message\": \"<string>\",\n  \"lineno\": \"<integer>\",\n  \"colno\": \"<integer>\",\n  \"stackTrace\": \"<string>\",\n  \"filename\": \"<string>\",\n  \"tz\": \"<string>\",\n  \"pg\": \"<string>\",\n  \"lc\": \"<string>\",\n  \"meta\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\",\n    \"key_2\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "281dfa17-3f84-40ed-aad8-1b2f82800e47",
