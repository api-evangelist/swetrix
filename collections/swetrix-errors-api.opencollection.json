{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swetrix Admin Annotations Errors API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Errors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Record Error Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swetrix.com/log/error",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Records a JavaScript error event for aggregation in the Errors tab of the dashboard. Captures error name, message, stack trace, source file, and location. Errors are grouped by name and message."
        },
        {
          "info": {
            "name": "List Error Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swetrix.com/v1/log/errors",
            "params": [
              {
                "name": "pid",
                "value": "",
                "type": "query",
                "description": "Project ID"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Time period for the query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Custom range start date (YYYY-MM-DD)"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Custom range end date (YYYY-MM-DD)"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query",
                "description": "IANA timezone name (default Etc/GMT)"
              },
              {
                "name": "filters",
                "value": "",
                "type": "query",
                "description": "JSON array of filter objects"
              },
              {
                "name": "take",
                "value": "",
                "type": "query",
                "description": "Number of results to return (max 150)"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Returns a paginated list of error event groups for the specified project and time period."
        },
        {
          "info": {
            "name": "Get Error Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swetrix.com/v1/log/get-error",
            "params": [
              {
                "name": "pid",
                "value": "",
                "type": "query",
                "description": "Project ID"
              },
              {
                "name": "eid",
                "value": "",
                "type": "query",
                "description": "Error group ID"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Time period for the query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Custom range start date (YYYY-MM-DD)"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Custom range end date (YYYY-MM-DD)"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query",
                "description": "IANA timezone name (default Etc/GMT)"
              }
            ]
          },
          "docs": "Returns detailed information for a specific error group by error ID."
        },
        {
          "info": {
            "name": "Get Error Statistics Overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swetrix.com/v1/log/error-overview",
            "params": [
              {
                "name": "pid",
                "value": "",
                "type": "query",
                "description": "Project ID"
              },
              {
                "name": "timeBucket",
                "value": "",
                "type": "query",
                "description": "Time bucket for data aggregation"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Time period for the query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Custom range start date (YYYY-MM-DD)"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Custom range end date (YYYY-MM-DD)"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query",
                "description": "IANA timezone name (default Etc/GMT)"
              }
            ]
          },
          "docs": "Returns aggregated error statistics for chart rendering, showing error counts over the specified time period."
        }
      ]
    }
  ],
  "bundled": true
}