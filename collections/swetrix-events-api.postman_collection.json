        {
          "id": "0f94043c-d8a4-45c0-881c-9560251f3c42",
          "name": "Record Custom Event",
          "request": {
            "name": "Record Custom Event",
            "description": {
              "content": "Records a custom named event for the specified project. Custom events can include metadata key-value pairs and are aggregated in the dashboard. Can be configured to track only unique occurrences per session.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "log",
                "custom"
              ],
              "host": [
                "{{baseUrl}}"
