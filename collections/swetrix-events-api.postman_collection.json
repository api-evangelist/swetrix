          "name": "Record Pageview Event",
          "request": {
            "name": "Record Pageview Event",
            "description": {
              "content": "Records a pageview event for the specified project. Tracks page path, locale, referrer, UTM parameters, and optional performance metrics. Should be called when a visitor loads a page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "log"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pid\": \"<string>\",\n  \"pg\": \"<string>\",\n  \"lc\": \"<string>\",\n  \"ref\": \"<string>\",\n  \"so\": \"<string>\",\n  \"me\": \"<string>\",\n  \"ca\": \"<string>\",\n  \"tz\": \"<string>\",\n  \"unique\": \"<boolean>\",\n  \"perf\": {\n    \"dns\": \"<number>\",\n    \"tls\": \"<number>\",\n    \"conn\": \"<number>\",\n    \"response\": \"<number>\",\n    \"render\": \"<number>\",\n    \"dom_load\": \"<number>\",\n    \"page_load\": \"<number>\",\n    \"ttfb\": \"<number>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
