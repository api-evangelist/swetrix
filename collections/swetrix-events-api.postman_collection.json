              "mode": "raw",
              "raw": "{\n  \"pid\": \"<string>\",\n  \"ev\": \"<string>\",\n  \"pg\": \"<string>\",\n  \"lc\": \"<string>\",\n  \"ref\": \"<string>\",\n  \"so\": \"<string>\",\n  \"me\": \"<string>\",\n  \"ca\": \"<string>\",\n  \"unique\": \"<boolean>\",\n  \"meta\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\"\n  }\n}",
