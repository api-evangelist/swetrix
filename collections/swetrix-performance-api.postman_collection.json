        {
          "id": "8f80f8fc-0150-4099-b8cd-8649f79b93fe",
          "name": "Get Performance Metrics",
          "request": {
            "name": "Get Performance Metrics",
            "description": {
              "content": "Returns performance metrics including DNS lookup, TLS handshake, connection, response, render, DOM load, TTFB, and full page load times. Supports median, average, p95, and quantile aggregations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "log",
                "performance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "(Required) Project ID"
                },
                {
                  "disabled": false,
                  "key": "timeBucket",
                  "value": "<string>",
                  "description": "(Required) Time bucket for data aggregation"
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) Time period for the query"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Custom range start date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "Custom range end date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "Etc/GMT",
                  "description": "IANA timezone name (default Etc/GMT)"
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<string>",
                  "description": "JSON array of filter objects"
                },
                {
                  "disabled": false,
                  "key": "measure",
                  "value": "median",
                  "description": "Statistical measure to apply to performance data"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
