          "id": "70a76713-2fc5-4089-9a3f-1eb9364fb8d2",
          "name": "Get Custom Events Data",
          "request": {
            "name": "Get Custom Events Data",
            "description": {
              "content": "Returns custom event analytics grouped by time bucket for specified event names. Returns counts and trends for each custom event.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "log",
                "custom-events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "(Required) Project ID"
                },
                {
                  "disabled": false,
                  "key": "timeBucket",
                  "value": "<string>",
                  "description": "(Required) Time bucket for data aggregation"
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) Time period for the query"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Custom range start date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "Custom range end date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "Etc/GMT",
                  "description": "IANA timezone name (default Etc/GMT)"
                },
                {
                  "disabled": false,
                  "key": "customEvents",
                  "value": "<string>",
                  "description": "(Required) JSON array of custom event names to query"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
