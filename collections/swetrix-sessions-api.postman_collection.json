            },
            "url": {
              "path": [
                "v1",
                "log",
                "sessions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "(Required) Project ID"
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "(Required) Time period for the query"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Custom range start date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to",
