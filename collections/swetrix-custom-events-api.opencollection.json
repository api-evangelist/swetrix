{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swetrix Admin Annotations Custom Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Custom Events Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swetrix.com/v1/log/custom-events",
            "params": [
              {
                "name": "pid",
                "value": "",
                "type": "query",
                "description": "Project ID"
              },
              {
                "name": "timeBucket",
                "value": "",
                "type": "query",
                "description": "Time bucket for data aggregation"
              },
              {
                "name": "period",
                "value": "",
                "type": "query",
                "description": "Time period for the query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Custom range start date (YYYY-MM-DD)"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "Custom range end date (YYYY-MM-DD)"
              },
              {
                "name": "timezone",
                "value": "",
                "type": "query",
                "description": "IANA timezone name (default Etc/GMT)"
              },
              {
                "name": "customEvents",
                "value": "",
                "type": "query",
                "description": "JSON array of custom event names to query"
              }
            ]
          },
          "docs": "Returns custom event analytics grouped by time bucket for specified event names. Returns counts and trends for each custom event."
        }
      ]
    }
  ],
  "bundled": true
}